@inject NavigationManager Navigation

<div class="forge-login">
    <AuthorizeView>
        <Authorized Context="authenticationState">
            <span class="forge-login__identity">
                @authenticationState.User.Identity?.Name
            </span>
            <form method="post" action="/account/logout">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <button type="submit" class="btn btn-outline-secondary btn-sm">Log out</button>
            </form>
        </Authorized>
        <NotAuthorized>
            <form method="post" action="/account/login">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />
                <button type="submit" class="btn btn-primary btn-sm">Log in</button>
            </form>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private string ReturnUrl
    {
        get
        {
            var relativeUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
            return string.IsNullOrEmpty(relativeUrl) ? "/" : $"/{relativeUrl}";
        }
    }
}
