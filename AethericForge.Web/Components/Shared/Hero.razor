<section class="hero">
    <div class="hero__glow hero__glow--one" aria-hidden="true"></div>
    <div class="hero__glow hero__glow--two" aria-hidden="true"></div>

    <div class="hero__content">
        @if (Model.Eyebrow is not null)
        {
            <p class="hero-eyebrow">
                @Model.Eyebrow
            </p> 
        }

        <h1 class="hero-title">@Model.Title</h1>

        <p class="hero-subtitle">
            @Model.Subtitle
        </p>

        <div class="hero-actions">
            @if (Model.PrimaryAction is not null)
            {
                <a class="hero-primary-action"
                   href="@Model.PrimaryAction.Url">
                    @Model.PrimaryAction.Label
                </a>
            }

            @if (Model.SecondaryAction is not null)
            {
                <a class="hero-secondary-action"
                   href="@Model.SecondaryAction.Url">
                    @Model.SecondaryAction.Label
                </a>
            }
        </div>
    </div>

    <div class="hero__signal" aria-hidden="true">
        <span class="hero__signal-label">The Forge</span>
        <div class="hero__signal-ring hero__signal-ring--outer"></div>
        <div class="hero__signal-ring hero__signal-ring--middle"></div>
        <div class="hero__signal-ring hero__signal-ring--inner"></div>
        <div class="hero__signal-core"></div>
        <span class="hero__signal-note hero__signal-note--top">OPEN BY DESIGN</span>
        <span class="hero__signal-note hero__signal-note--bottom">BUILD · TEACH · SHARE</span>
    </div>
</section>

@code
{
    [Parameter, EditorRequired]
    public HeroModel Model { get; set; } = default!;
}
