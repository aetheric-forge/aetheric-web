@using Microsoft.AspNetCore.Components.Authorization
<div class="authentication-widget" aria-label="Campus account">
    <AuthorizeView Context="authenticationState">
        <Authorized>
            <div class="authentication-widget__identity">
                <span class="authentication-widget__status" aria-hidden="true"></span>
                <span>
                    Signed in as
                    <strong>@(authenticationState.User.Identity?.Name ?? "Campus member")</strong>
                </span>
            </div>

            <form method="post" action="/account/logout">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-outline-secondary">Log out</button>
            </form>
        </Authorized>

        <NotAuthorized>
            <span class="authentication-widget__message">Not signed in</span>
            <a class="btn btn-primary" href="/login?returnUrl=%2F">Log in</a>
        </NotAuthorized>
    </AuthorizeView>
</div>
