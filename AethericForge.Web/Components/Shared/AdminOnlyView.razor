@* Wraps content on an [Authorize(Policy = AdministratorPolicy)] page so it also respects the
   "View as user" toggle: the route itself stays genuinely admin-only (the policy is untouched),
   but while viewing as a user, the page renders the same way a non-admin hitting a page they can't
   reach would - not just a hidden nav link, the actual content is replaced too. *@
@if (ViewAsUser)
{
    <main class="container py-5">
        <h1>Not Found</h1>
        <p>Sorry, the content you are looking for does not exist.</p>
    </main>
}
else
{
    @ChildContent
}

@code {
    [CascadingParameter(Name = "ViewAsUser")]
    public bool ViewAsUser { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
