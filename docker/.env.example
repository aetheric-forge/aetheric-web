# Copy this file to .env.local and replace every required placeholder.
# Docker Compose injects these values when the container starts; they are not
# copied into the image during docker build.

ASPNETCORE_ENVIRONMENT=Development

Keycloak__Authority=https://keycloak.example.com
Keycloak__Realm=change-me

Organization__Id=architecture
Organization__DisplayName=Architecture
Organization__MemberGroupId=adr-members
Organization__MaintainerGroupId=adr-maintainers

MongoDb__Host=mongodb.example.com
MongoDb__Port=27017
MongoDb__DatabaseName=change-me
MongoDb__AuthenticationDatabase=admin
MongoDb__AuthenticationMechanism=SCRAM-SHA-256
MongoDb__DirectConnection=true

RabbitMq__Host=rabbitmq.example.com
RabbitMq__Port=5672
RabbitMq__VirtualHost=/
RabbitMq__Ssl=false

Redis__Host=redis.example.com
Redis__Port=6379
Redis__Ssl=false
Redis__Database=0

S3__ServiceUrl=https://s3.example.com
S3__BucketName=change-me
S3__ForcePathStyle=true
S3__AuthenticationRegion=us-east-1

# Credentials belong to institutions. See docs/architecture/service-configuration.md.
Registry__Keycloak__ClientId=change-me
Registry__Keycloak__ClientSecret=change-me
Library__MongoDb__Username=change-me
Library__MongoDb__Password=change-me
ParallelYou__MongoDb__Username=change-me
ParallelYou__MongoDb__Password=change-me
Decisions__MongoDb__Username=change-me
Decisions__MongoDb__Password=change-me
Maintenance__MongoDb__Username=change-me
Maintenance__MongoDb__Password=change-me
PostOffice__RabbitMq__Username=change-me
PostOffice__RabbitMq__Password=change-me
Decisions__RabbitMq__Username=change-me
Decisions__RabbitMq__Password=change-me
ForgeCampus__Redis__Password=change-me
Workbench__Redis__Password=change-me
Archive__S3__AccessKey=change-me
Archive__S3__SecretKey=change-me
ParallelYou__S3__AccessKey=change-me
ParallelYou__S3__SecretKey=change-me
Decisions__S3__AccessKey=change-me
Decisions__S3__SecretKey=change-me
